# Prod: own domain on the home VPN, Let's Encrypt cert via DNS-01 (no public port needed).
(tls-dns) {
	tls {
		dns {$DNS_PROVIDER:godaddy} {file.{$DNS_API_TOKEN_FILE}}
		# GoDaddy's nameservers pick up a new TXT record (and drop the last one) only after a while:
		# validating at once let Let's Encrypt see the previous attempt's value. Wait first.
		propagation_delay 90s
		propagation_timeout 10m
	}
}
# Local prod smoke test only (compose.prodtest.yml, TLS_MODE=internal): Caddy's internal CA.
(tls-internal) {
	tls internal
}
# Container healthcheck (compose): plain HTTP, loopback only, answered by Caddy itself, so
# "healthy" means Caddy runs, not that the backend does (the backend has its own healthcheck).
http://:8081 {
	bind 127.0.0.1
	respond "ok"
}
{$DOMAIN} {
	import tls-{$TLS_MODE:dns}
	encode zstd gzip
	# Notes are rendered HTML from git: the CSP is the second line of defence after DOMPurify
	# (#31). CodeMirror injects <style> elements, hence style 'unsafe-inline'.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		# The AI's user_location asks the browser for the position (#151): only the app itself, never an embedded page.
		Permissions-Policy "geolocation=(self)"
	}
	# handle blocks are mutually exclusive, so the SPA fallback never swallows /api.
	handle /api/* {
		# Streams (NDJSON chat/events) must not be buffered.
		reverse_proxy backend:8787 {
			flush_interval -1
		}
	}
	handle {
		root * /srv
		@sw path /sw.js /registerSW.js /manifest.webmanifest
		header @sw Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
