# Relay from a stack's internal network to the model server on the Mac (omlx, deploy/settings/), used by
# compose.dev.yml (`ollama`) and compose.prodtest.yml (`ollama-bridge`). Only the OpenAI-compatible API that
# opencode calls passes; Ollama's admin API (pull, delete, create, …) stays out of the AI's reach.
# OLLAMA_UPSTREAM: where Ollama answers (deploy/settings/ `gateways.ollama.relay_upstream`): the Mac as
# Docker Desktop/Rancher (host.docker.internal) sees it.
{
	admin off
	auto_https off
}
:11434 {
	handle /v1/* {
		reverse_proxy {$OLLAMA_UPSTREAM} {
			# A loopback-bound Ollama answers 403 to any Host but localhost (DNS-rebinding guard).
			header_up Host localhost:11434
			flush_interval -1
		}
	}
	respond 403
}
