# Rendered by Ansible (role app): what is specific to target {{ target }}.
services:
{% if app_ingest_vaults | default([]) %}
  # Only what the ingest service needs: Input/ to write, Sources/ to look up duplicates.
  ingest:
    volumes:
{% for v in app_ingest_vaults %}
      - {{ vaults_fs_mount }}/{{ v }}/Input:/vaults/{{ v }}/Input
      - {{ vaults_fs_mount }}/{{ v }}/Sources:/vaults/{{ v }}/Sources:ro
{% endfor %}
{% endif %}
{% if not (app_ingest_vaults | default([])) %}
  {}
{% endif %}

volumes:
  # The vaults live on the loop-mounted filesystem (role vaults_fs), not in Docker's volume dir.
  vaults:
    driver: local
    driver_opts: { type: none, o: bind, device: {{ vaults_fs_mount }} }
