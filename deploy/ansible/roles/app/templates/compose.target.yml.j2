# Rendered by Ansible (role app): what is specific to target {{ target }}.
services:
{% if remotes_dir is defined %}
  # Local bare repos instead of GitHub (the e2e suite's remotes; deploy/settings/ sets git.remote_base).
  backend:
    environment:
      # The VM's /remotes share belongs to the Mac's uid: git refuses it as "dubious ownership".
      GIT_CONFIG_COUNT: "1"
      GIT_CONFIG_KEY_0: safe.directory
      GIT_CONFIG_VALUE_0: /remotes/*
    volumes:
      - {{ remotes_dir }}:/remotes
{% endif %}
{% if app_settings_env.OLLAMA_UPSTREAM is defined %}
  # The gateway is the Mac's native Ollama (deploy/settings/): opencode reaches it through this /v1-only relay.
  opencode:
    environment:
      # Ollama sits on a private IP, which the egress proxy refuses: reach it direct.
      NO_PROXY: localhost,127.0.0.1,0.0.0.0,ollama.internal
  ollama-relay:
    image: caddy:2.10-alpine
    restart: unless-stopped
    environment:
      OLLAMA_UPSTREAM: ${OLLAMA_UPSTREAM}
    volumes: ["./Caddyfile.ollama-relay:/etc/caddy/Caddyfile:ro"]
    networks:
      internal: { aliases: [ollama.internal] }
      egress: {}
{% endif %}
{% if remotes_dir is not defined and app_settings_env.OLLAMA_UPSTREAM is not defined %}
  {}
{% endif %}

volumes:
  # The vaults live on the loop-mounted filesystem (role vaults_fs), not in Docker's volume dir.
  vaults:
    driver: local
    driver_opts: { type: none, o: bind, device: {{ vaults_fs_mount }} }
