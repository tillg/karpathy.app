{
  "name": "karpathy.app",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [8010],
  "portsAttributes": {
    "8010": { "label": "karpathy #1", "protocol": "https", "onAutoForward": "notify" }
  },
  "otherPortsAttributes": { "onAutoForward": "silent" },
  "secrets": {
    "OPENROUTER_API_KEY": {
      "description": "The dev stacks' model gateway (a codespace has no omlx). Seeded into deploy/secrets/openrouter_api_key."
    },
    "EXA_API_KEY": { "description": "Optional: the AI's web search. Seeded into deploy/secrets/exa_api_key." },
    "NTFY_DEV_TOPIC": { "description": "Optional: the ntfy dev topic for progress messages. Seeded into tmp/.ntfy_dev_topic." },
    "ANTHROPIC_API_KEY": { "description": "Optional: Claude Code without an interactive login." }
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "tillg/ingest_email": { "permissions": { "contents": "read" } },
        "tillg/karpathy_demo_wiki": { "permissions": { "contents": "write" } }
      }
    },
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "ms-playwright.playwright"]
    }
  }
}
