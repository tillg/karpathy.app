<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Written by `karpathy-instagram-worker service install`; replaced on every install. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>$exe</string>
    <string>run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
$environment
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- At most one restart a minute (e.g. while the worker token is rejected). -->
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <!-- SIGTERM lets the job in progress finish; SIGKILL only after 5 minutes. -->
  <key>ExitTimeOut</key>
  <integer>300</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>$log</string>
  <key>StandardErrorPath</key>
  <string>$log</string>
</dict>
</plist>
