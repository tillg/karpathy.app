tmp/
.playwright-mcp/

# macOS
.DS_Store
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes

# deploy secrets / local settings overrides (deploy/settings/<env>.local.yaml)
deploy/secrets/
deploy/settings/*.local.yaml
# from before deploy/settings/ (#133); dev.sh refuses to start while they exist
deploy/.env
deploy/opencode.env
node_modules/
dist/
test-results/
playwright-report/

# md2html spec viewer (/spec:view): generated spec HTML and the index are local-only
specs/**/*.html
!specs/research/browser-only/browser-only-report.html
!specs/changes/v1/v1-plan.html
!specs/research/prod-env/prod-env-report.html
# hand-written / separately built HTML under specs/ stays committed
!specs/research/features/feature-report.html
!specs/01_mvp/layouts/*.html
!specs/research/browser-only/spikes/**/*.html
/index.html
!specs/**/*-report.html
/DECISIONS.html
_site/
